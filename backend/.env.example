PORT=5000
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=squadhire
R2_PUBLIC_URL=https://your-r2-public-url
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# SquadHub integration — SQUADHUB_WEBHOOK_SECRET is required (or the inbound
# webhook returns 503). The two callback vars are optional; when unset the
# outbound accept/reject delivery is skipped with a logged reason. Keep
# secrets in sync with SquadHub's .env (SQUADHIRE_WEBHOOK_SECRET and
# SQUADHIRE_CALLBACK_SECRET on that side).
SQUADHUB_WEBHOOK_SECRET=
SQUADHUB_CALLBACK_URL=http://localhost:4000/integrations/squadhire/card-responses
SQUADHUB_CALLBACK_SECRET=
# Jobs (hiring) module: where the outbox posts candidate/interview/offer/Q&A
# events so the SquadHub admin mirror stays in sync. REQUIRED for job cards —
# if unset, every jobs event stalls in squadhub_event_outbox with
# 'jobs_events_url_not_configured' and nothing reaches the admin panel.
# Signed with SQUADHUB_CALLBACK_SECRET (X-SquadHub-Signature).
SQUADHUB_JOBS_EVENTS_URL=http://localhost:4000/integrations/squadhire/jobs/events
# Base origin of the SquadHub server API for "Sign in with SquadHub" SSO (one-time
# code exchange + staff directory). Optional — defaults to SQUADHUB_CALLBACK_URL's
# origin. Server-to-server calls reuse SQUADHUB_CALLBACK_SECRET for signing.
SQUADHUB_API_URL=http://localhost:4000
# Public origin that serves the /apply/* lead-capture forms. Used to build the
# public_url returned to SquadHub's "Public Forms" panel. Defaults to the prod
# domain in code; override here for staging/other environments.
PUBLIC_FORMS_BASE_URL=https://squadhire.upsquadconnect.com

# Author stamped on candidate writes (status changes, notes) that arrive from
# SquadHub's Candidates mini app via /api/integrations/squadhub/candidates/*.
# Must be a valid uuid (lead_notes.created_by is NOT NULL) or those writes
# return 503. Use a dedicated "SquadHub service" user id.
SQUADHUB_SERVICE_USER_ID=

# upsquad admin API — proxies inbound subscription requests from the upsquad
# pricing page so admins can publish them as talent cards. UPSQUAD_API_TOKEN
# must match upsquad server's ADMIN_API_TOKEN. When unset, the proxy endpoints
# return 503 and the From-Requests admin tab is empty.
UPSQUAD_API_URL=http://localhost:3100
UPSQUAD_API_TOKEN=

# SquadHire CRM (shcrm) inbound — when the CRM pushes a lead-stage change
# back here it must include this value in X-SquadCRM-Signature. Must match
# the SquadCRM side's outbound secret. When unset, /webhooks/squadcrm/lead-stage
# returns 503 (kept zero-config for local dev).
SQUADCRM_INBOUND_SECRET=

# Original Squad CRM (crm.squadhub.in) inbound — POST /integrations/squadcrm/
# business/provision provisions a business user when a deal enters the "Give
# SQUADHire Access" stage. Sent in X-SquadCRM-Signature; must equal Squad CRM's
# SQUADHIRE_PROVISION_SECRET (>=32 chars). Distinct from SQUADCRM_INBOUND_SECRET.
# When unset, the provision route returns 503.
SQUADCRM_PROVISION_SECRET=

# Notify talents when a card is *ingested* (created/edited/synced via the
# SquadHub webhook), not just when it's explicitly broadcast. Default false:
# ingest silently syncs the card + reconciles recipient rows (the card still
# shows in talent queues), but push + WhatsApp fire only on an explicit
# broadcast / manual assignment. Set to true to restore "ingest also notifies".
NOTIFY_TALENT_ON_INGEST=false

# ---------------------------------------------------------------------------
# Mobile in-app updaters
# ---------------------------------------------------------------------------
# Legacy talent-app download config (used by /api/app-config + the download
# landing page). The in-app updater below supersedes this for version checks.
TALENT_APP_MIN_VERSION=1.0.0
TALENT_APP_DOWNLOAD_URL=https://squadhire.upsquadconnect.com/talent-app/talent-app-latest.apk

# In-app updater manifests served by GET /api/talent-app/version and
# GET /api/admin-lite/version. Optional path overrides — when unset the backend
# reads the committed defaults backend/talent-app-release-manifest.json and
# backend/admin-lite-release-manifest.json. In production point these at the
# host files the release scripts (scripts/release.sh in each mobile app) write:
TALENT_APP_MANIFEST_PATH=/var/www/talent-app-downloads/version.json
ADMIN_LITE_MANIFEST_PATH=/var/www/admin-lite-downloads/version.json
