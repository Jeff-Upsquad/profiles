# Template for the HOSTED DEMO backend env → copy to /root/Profiles-demo/backend/.env
# and fill in the real values. NEVER commit the filled-in file (it holds secrets).
#
# Points the demo stack at the dedicated DEMO Supabase project. Integration
# secrets (SquadHub / SquadCRM / WhatsApp / push) are intentionally left UNSET
# so the demo fires no external side-effects.
PORT=5001
SUPABASE_URL=https://<demo-project-ref>.supabase.co
SUPABASE_ANON_KEY=<demo anon key>
SUPABASE_SERVICE_ROLE_KEY=<demo service_role key>
JWT_SECRET=<any random string>
CORS_ORIGIN=https://squadhire-demo.upsquadconnect.com
FRONTEND_URL=https://squadhire-demo.upsquadconnect.com
# Used by seed-demo.ts / apply-schema.ts (demo DB only); the seed REFUSES to run
# unless SUPABASE_URL contains DEMO_REF — a guard so it can never touch prod.
DEMO_REF=<demo-project-ref>
DEMO_DB_PASSWORD=<demo db password>
