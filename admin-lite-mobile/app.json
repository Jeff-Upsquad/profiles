{
  "expo": {
    "name": "Admin Lite",
    "slug": "squadhire-admin-lite",
    "version": "2.0.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "adminlite",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "android": {
      "package": "in.upsquadconnect.squadhire.adminlite",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiUrl": "https://squadhire.upsquadconnect.com/api",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0ccf95d1-f82b-4bd3-b4e3-9156e97ec344"
      }
    },
    "owner": "upsquad_connect"
  }
}
